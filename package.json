{
  "name": "bili-toolkit",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "B 站多账号多权益工具箱：多账号无缝漫游、软登出凭据保活、大会员权益借用、4K/杜比解锁",
  "keywords": [
    "bilibili",
    "userscript",
    "tampermonkey",
    "vip"
  ],
  "license": "MIT",
  "author": "arisvia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arisvia/bili-toolkit.git"
  },
  "homepage": "https://github.com/arisvia/bili-toolkit#readme",
  "bugs": {
    "url": "https://github.com/arisvia/bili-toolkit/issues"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev --watch",
    "check": "node build.mjs --check",
    "check:contrast": "node tools/contrast-check.mjs",
    "test": "node test/smoke.test.mjs && node test/cookie-parse.test.mjs && node test/accounts.test.mjs && node test/proxy.test.mjs && node test/hook.test.mjs",
    "verify": "npm run test && npm run check:contrast && npm run verify:online && npm run build",
    "verify:online": "node tools/online-check.mjs",
    "verify:local": "node tools/verify-local.mjs",
    "verify:cookie": "node tools/verify-cookie.mjs",
    "gen:md5": "node tools/gen-md5.mjs",
    "harness": "node build.mjs && node tools/harness-server.mjs",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "uqr": "^0.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
